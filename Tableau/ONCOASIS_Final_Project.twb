            <zone fixed-size='160' forceUpdate='true' h='21875' id='35' is-fixed='true' type-v2='text' w='62006' x='19034' y='46616'>
              <formatted-text>
                <run bold='true' fontsize='18' underline='true'>CHALLENGES</run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- </run>
                <run bold='true' fontsize='14'>Complexity</run>
                <run fontsize='14'> of merging diverse clinical datasets (TCGA/NHANES).</run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- Ensuring </run>
                <run bold='true' fontsize='14'>data privacy</run>
                <run fontsize='14'> and regulatory compliance. </run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- Normalizing </run>
                <run bold='true' fontsize='14'>heterogeneous</run>
                <run fontsize='14'> clinical metrics.</run>
              </formatted-text>
              <zone-style>
