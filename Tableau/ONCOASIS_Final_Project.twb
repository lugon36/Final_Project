              <formatted-text>
                <run bold='true' fontsize='18' underline='true'>CONCLUSIONS</run>
                <run bold='true' fontsize='18'>Æ </run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- Data-driven oncology is achievable.</run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- </run>
                <run bold='true' fontsize='14'>Precision medicine</run>
                <run fontsize='14'> improves patient quality of life.</run>
                <run>Æ&#10;</run>
                <run fontsize='14'>- The &quot;SQL Engine&quot; provides clinical </run>
                <run bold='true' fontsize='14'>transparency.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#666666' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
