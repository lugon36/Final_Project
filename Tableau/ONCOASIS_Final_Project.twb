                                <formatted-text>
                                  <run bold='true' fontsize='12'>App Overview – Integrated Oncology Care:</run>
                                  <run>Æ&#10;</run>
                                  <run bold='true' fontsize='12'>     - Overview:</run>
                                  <run fontsize='12'> Clinical Overview. Consolidates patient profiles and baseline metrics, providing an immediate snapshot of the clinical situation.</run>
                                  <run>Æ&#10;</run>
                                  <run bold='true' fontsize='12'>     - Pharmacology:</run>
                                  <run fontsize='12'> Integrated drug-interaction checks and dosage recommendations.</run>
                                  <run>Æ&#10;</run>
                                  <run bold='true' fontsize='12'>     - Nutrition:</run>
                                  <run fontsize='12'> Personalized diet plans based on patient diagnosis.</run>
                                  <run>Æ&#10;</run>
                                  <run bold='true' fontsize='12'>     - Physical Activity:</run>
                                  <run fontsize='12'> Tailored exercise intensity levels to improve treatment prognosis.</run>
                                  <run>Æ&#10;</run>
                                  <run bold='true' fontsize='12'>     - SQL Analytics: </run>
                                  <run fontsize='12'>Displays systemic oncology data (TCGA/NHANES) and evidence-based international oncology guidelines (NCCN, ASCO, ESMO, SEOM)</run>
                                </formatted-text>
                              </zone>
                            </dashboard>
                          </capturedDeltas>
                        </story-point>
