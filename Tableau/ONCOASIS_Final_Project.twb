            <zone forceUpdate='true' h='37890' id='30' type-v2='text' w='89678' x='9736' y='61068'>
              <formatted-text>
                <run bold='true' fontsize='10'>App Overview – Integrated Oncology Care:</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='10'>     - Overview:</run>
                <run fontsize='10'> Clinical Overview. Consolidates patient profiles and baseline metrics, providing an immediate snapshot of the clinical situation.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='10'>     - Pharmacology:</run>
                <run fontsize='10'> Integrated drug-interaction checks and dosage recommendations.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='10'>     - Nutrition:</run>
                <run fontsize='10'> Personalized diet plans based on patient diagnosis.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='10'>     - Physical Activity:</run>
                <run fontsize='10'> Tailored exercise intensity levels to improve treatment prognosis.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontsize='10'>     - SQL Analytics: </run>
                <run fontsize='10'>Displays systemic oncology data (TCGA/NHANES) and evidence-based international oncology guidelines (NCCN, ASCO, ESMO, SEOM)</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='37890' id='31' param='horz' type-v2='layout-flow' w='9150' x='586' y='61068' />
